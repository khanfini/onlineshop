# Security
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Local database (SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Railway PostgreSQL: reference the database service's DATABASE_URL variable.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Local development keeps media in ./media. On Railway, mount a volume at /media.
# MEDIA_ROOT=/media

# Production HTTPS: enable preload only after verifying HTTPS on all subdomains.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_PRELOAD=False

# Optional SMTP settings for production email delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
